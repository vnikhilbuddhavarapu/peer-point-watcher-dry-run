{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "peer-point-watcher-dry-run",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "ai": { "binding": "AI", "remote": true },
  "browser": { "binding": "BROWSER", "remote": true },
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "peer-point-montreal-snapshots","preview_bucket_name": "peer-point-montreal-snapshots" }],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "WATCHER_AGENT", "class_name": "WatcherAgent" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WatcherAgent"] }],
  "vars": {
    "AI_GATEWAY_ID": "default",
    "MOCK_PAGE_BASE_URL": "https://peer-point-mock-pages.peer-point-user-group.workers.dev",
    "WATCH_PATH": "/market-cycle",
    "CITY": "Montreal",
    "CARD": "watcher",
    "ENVIRONMENT": "starter",
  },
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
}
